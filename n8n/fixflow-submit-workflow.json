    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a maintenance triage assistant.\n\nUse ONLY the tenant's report below. Do not diagnose beyond the information given.\nYour job is to categorise, summarise, and recommend the most suitable maintenance team.\n\nISSUE TYPE: {{ $json.fields['Issue Type'] }}\nDESCRIPTION: {{ $json.fields.Description }}\nPROPERTY USABLE: {{ $json.fields['Property Usable'] }}\nSTARTED: {{ $json.fields['Started At'] }}\n\nReturn RAW JSON only:\n{\n  \"category\": \"Plumbing|Electrical|Heating|Security|Appliance|Other\",\n  \"suggested_priority\": \"LOW|MEDIUM|HIGH|CRITICAL\",\n  \"recommended_team\": \"\",\n  \"issue_summary\": \"\",\n  \"safety_note\": \"\"\n}\n\nPriority guidance:\n- CRITICAL: immediate threat to life/safety, major uncontrolled flooding, exposed live electrical danger, serious security risk.\n- HIGH: rapidly worsening issue or serious loss of essential function.\n- MEDIUM: important but stable issue.\n- LOW: minor/cosmetic/non-urgent issue.\n\nIf facts are insufficient, do not invent details.\nOnly state facts given in the input. Property usable is: {{ $json.fields['Property Usable'] }}. Do not guess or contradict it.\n",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        672,
        0
      ],
      "id": "8e311005-3d14-4400-83f7-c9c7fdcc7cba",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "model": "ministral-14b-latest",
        "options": {
          "temperature": 0.2
        }
      },

      "typeVersion": 1,
      "position": [
        752,
        240
      ],
      "id": "257b360d-1655-437f-b12d-8ab4c513e363",
      "name": "Mistral Cloud Chat Model",
      "credentials": {
        "mistralCloudApi": {
          "id": "eUKEu5TtZw5JgR2H",
          "name": "Mistral Cloud account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cleaned = $json.text.replace(/```json|```/g, '').trim();\nconst triage = JSON.parse(cleaned);\n\nreturn [{\n  json: {\n    ...$('Prepare Ticket').first().json,\n    ...triage\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        0
      ],
      "id": "8282b6a1-91e7-4237-a5d8-820449fa86c8",
      "name": "Parse Triage"
    },
    {
      "parameters": {
        "jsCode": "const p = $json.suggested_priority;\nlet finalPriority = p;\n\nif ($json.property_usable === \"No\" && p === \"LOW\") {\n  finalPriority = \"MEDIUM\";\n}\n\nreturn [{ json: { ...$json, final_priority: finalPriority } }];"
      },
      "type": "n8n-nodes-base.code",
